# Example environment for the network-anomaly CLI. Copy to .env and export it in your shell;
# the toolkit does not load .env files by itself. Never commit a real .env file.

# Default log level and format for every command (same as --log-level / --log-format).
NETWORK_ANOMALY_LOG_LEVEL=INFO
NETWORK_ANOMALY_LOG_FORMAT=text

# Render plots without a graphical desktop (headless servers, CI).
MPLBACKEND=Agg
