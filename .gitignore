# Datasets: never commit raw, processed or generated data (see data/README.md)
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Generated artifacts
reports/
models/
*.joblib
*.pt

# Editors / OS
.idea/
.vscode/
.DS_Store
